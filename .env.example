# Frontend (Vite exposes VITE_ vars to the browser bundle)
VITE_STADIA_API_KEY=
# Where the frontend sends API calls. Empty means localhost:8080 in dev and
# production on Fly in a build. Set it to https://nyc-subway-api.fly.dev to run
# only the frontend locally against production.
VITE_API_BASE=

# API server (optional — the map works without a database)
DATABASE_URL=postgres://localexpress:localexpress@localhost:5433/localexpress?sslmode=disable
# Required whenever DATABASE_URL is set: the API refuses to start without at
# least 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET=
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
APP_BASE_URL=http://localhost:5173
DEV_AUTO_VERIFY=true
ADMIN_EMAILS=

# Frontend
VITE_GOOGLE_CLIENT_ID=
