{
  "title": "NYC Subway API",
  "uid": "nyc-subway-api",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "tags": ["nyc-subway-3d"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Excludes /health: Fly checks it every 15s, which was 64% of all requests and drowned out real traffic.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{route!=\"/health\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "description": "From the histogram, so percentiles are computed across the whole distribution rather than from a mean.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Feed freshness",
      "description": "Seconds since each GTFS-RT feed last refreshed. Last-known-good caching hides a dead upstream from riders, so this is where it shows.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 180 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - feed_last_refresh_timestamp_seconds",
          "legendFormat": "{{group}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Feed failures by group",
      "description": "These series exist at zero from boot, so a flat line here is a positive signal rather than an absent one.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group) (rate(feed_refresh_total{result=\"failure\"}[15m]))",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Alerts carrying a readable label",
      "description": "Ratio of alerts with an MTA Mercury label to all cached alerts. Sits at 1.0. If it drops, their extension stopped parsing and every service alert silently went generic — nothing errors when that happens.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "alerts_labeled / alerts_entities", "legendFormat": "labeled" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap in use",
      "description": "512 MB machine holding the GTFS static files plus 8 decoded feeds. Observed steady around 171 MiB.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "go_memstats_heap_inuse_bytes", "legendFormat": "heap in use" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "description": "Refreshers fan out one goroutine per feed every 30s. A rising floor means they are not finishing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "go_goroutines", "legendFormat": "goroutines" }
      ]
    }
  ]
}
